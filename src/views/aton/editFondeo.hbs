<div class="container py-4">

    <!-- CABECERA -->
    <div class="text-center mb-5">
        <h1 class="display-6 fw-bold">
            <i class="bi bi-anchor-fill text-primary"></i>
            Editar fondeo de boya
        </h1>
        <p class="lead text-muted mb-0">
            NIF <strong>{{baliza.nif}}</strong>
        </p>
    </div>

    <form action="/aton/editFondeo/{{baliza.nif}}" method="POST">

        <!-- ===================================================== -->
        <!-- FLOTADOR -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-primary text-white">
                <i class="bi bi-life-preserver me-2"></i>
                Flotador ⚓
            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-lg-6">
                        <label class="form-label">Modelo / Tipo</label>
                        <input class="form-control" name="composicion_flotador" value="{{baliza.composicion_flotador}}">
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Diámetro</label>

                        <div class="input-group">
                            <input class="form-control" type="number" name="diametro_flotador"
                                value="{{baliza.diametro_flotador}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">Altura</label>

                        <div class="input-group">

                            <input class="form-control" type="number" name="altura_flotador"
                                value="{{baliza.altura_flotador}}">

                            <span class="input-group-text">cm</span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- CASTILLETE -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-primary text-white">

                <i class="bi bi-building me-2"></i>

                Castillete 🏗

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-lg-6">

                        <label class="form-label">Composición</label>

                        <input class="form-control" name="composicion_castillete"
                            value="{{baliza.composicion_castillete}}">

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">Ancho</label>

                        <div class="input-group">
                            <input class="form-control" type="number" name="ancho_castillete"
                                value="{{baliza.ancho_castillete}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">Altura</label>

                        <div class="input-group">
                            <input class="form-control" type="number" name="altura_castillete"
                                value="{{baliza.altura_castillete}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                    <div class="col-md-2">

                        <label class="form-label">Altura focal</label>

                        <div class="input-group">
                            <input class="form-control" type="number" name="altura_focal"
                                value="{{baliza.altura_focal}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Sección transversal
                        </label>

                        <div class="input-group">

                            <input class="form-control" type="number" step="0.01" name="seccion_castillete"
                                value="{{baliza.seccion_castillete}}">

                            <span class="input-group-text">m²</span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- FONDEO -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-success text-white">

                <i class="bi bi-water me-2"></i>

                Datos de fondeo 🌊

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-3">

                        <label class="form-label">
                            Calado
                        </label>

                        <div class="input-group">

                            <input class="form-control" type="number" step="0.01" name="calado"
                                value="{{baliza.calado}}">

                            <span class="input-group-text">m</span>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Longitud cadena
                        </label>

                        <div class="input-group">

                            <input class="form-control" type="number" step="0.01" name="longitud_cadena"
                                value="{{baliza.longitud_cadena}}">

                            <span class="input-group-text">m</span>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Diámetro cadena
                        </label>

                        <div class="input-group">

                            <input class="form-control" type="number" name="diametro_cadena"
                                value="{{baliza.diametro_cadena}}">

                            <span class="input-group-text">mm</span>

                        </div>

                    </div>

                    <div class="col-md-3">

                        <label class="form-label">
                            Ubicación
                        </label>

                        <select class="form-select" name="ubicacion">

                            <option value="interior" {{#when baliza.ubicacion 'eq' 'interior' }}selected{{/when}}>
                                Aguas interiores
                            </option>

                            <option value="intermedio" {{#when baliza.ubicacion 'eq' 'intermedio' }}selected{{/when}}>
                                Aguas intermedias
                            </option>

                            <option value="exterior" {{#when baliza.ubicacion 'eq' 'exterior' }}selected{{/when}}>
                                Aguas exteriores
                            </option>

                        </select>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- MUERTO -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-secondary text-white">

                <i class="bi bi-box-fill me-2"></i>

                Dimensiones del muerto ⚙

            </div>

            <div class="card-body">

                <div class="row g-4">

                    <div class="col-md-4">

                        <label class="form-label">
                            Largo (L)
                        </label>

                        <div class="input-group">
                            <input class="form-control" type="number" step="0.01" name="l_muerto"
                                value="{{baliza.l_muerto}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Ancho (B)
                        </label>

                        <div class="input-group">
                            <input class="form-control" type="number" step="0.01" name="b_muerto"
                                value="{{baliza.b_muerto}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                    <div class="col-md-4">

                        <label class="form-label">
                            Alto (H)
                        </label>

                        <div class="input-group">
                            <input class="form-control" type="number" step="0.01" name="h_muerto"
                                value="{{baliza.h_muerto}}">
                            <span class="input-group-text">cm</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

        <!-- ===================================================== -->
        <!-- ÁREAS -->
        <!-- ===================================================== -->

      <div class="card shadow-sm border-0 mb-4">

    <!-- Cabecera principal -->
    <div class="card-header bg-primary text-white">
        <h5 class="mb-0">
            📐 Áreas y coeficientes
        </h5>
    </div>

    <div class="card-body">

        <div class="row g-4">

            <!-- ================= OBRA VIVA ================= -->

            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-header">
                        Obra viva
                    </div>

                    <div class="card-body">

                        <label class="form-label">
                            Área sumergida
                        </label>

                        <div class="input-group mb-3">

                            <input
                                class="form-control"
                                type="number"
                                step="0.01"
                                name="area_total_muerta"
                                value="{{baliza.area_total_muerta}}">

                            <span class="input-group-text">
                                m²
                            </span>

                        </div>

                        <label class="form-label">
                            Cd hidrodinámico
                        </label>

                        <input
                            class="form-control"
                            type="number"
                            step="0.001"
                            name="Cd_aerodinamico"
                            value="{{baliza.Cd_aerodinamico}}">

                    </div>

                </div>

            </div>

            <!-- ================= OBRA MUERTA ================= -->

            <div class="col-lg-6">

                <div class="card h-100">

                    <div class="card-header">
                        Obra muerta
                    </div>

                    <div class="card-body">

                        <label class="form-label">
                            Área viento
                        </label>

                        <div class="input-group mb-3">

                            <input
                                class="form-control"
                                type="number"
                                step="0.01"
                                name="area_total_viva"
                                value="{{baliza.area_total_viva}}">

                            <span class="input-group-text">
                                m²
                            </span>

                        </div>

                        <label class="form-label">
                            Cw aerodinámico
                        </label>

                        <input
                            class="form-control"
                            type="number"
                            step="0.001"
                            name="Cw_aerodinamico"
                            value="{{baliza.Cw_aerodinamico}}">

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

        <!-- ===================================================== -->
        <!-- OBSERVACIONES -->
        <!-- ===================================================== -->

        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header">

                <i class="bi bi-chat-left-text me-2"></i>

                Observaciones 📝

            </div>

            <div class="card-body">

                <textarea class="form-control" rows="5" name="observaciones">{{baliza.observaciones}}</textarea>

            </div>

        </div>

        <!-- BOTONES -->

        <div class="d-flex justify-content-between mt-5">

            <a href="/aton/plantilla/{{baliza.nif}}" class="btn btn-outline-secondary btn-lg">

                <i class="bi bi-arrow-left"></i>

                Volver

            </a>

            <button class="btn btn-success btn-lg px-5">

                <i class="bi bi-check-circle"></i>

                Guardar cambios

            </button>

        </div>

    </form>

</div>